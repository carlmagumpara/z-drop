# All optional. Defaults are:
#   dev:  origin http://localhost:4000, API /api, socket path /socket.io
#   prod: same origin, API /api, socket path /socket.io
VITE_API_ORIGIN=
VITE_API_PATH=
VITE_SOCKET_PATH=

# WebRTC ICE configuration. STUN alone cannot connect peers behind symmetric
# NATs or restrictive firewalls — a TURN relay is required for reliable
# cross-network file sharing.
#
# Option A: a provider endpoint that returns an iceServers array (recommended,
# e.g. Metered's publishable TURN credential API key):
# VITE_TURN_CREDENTIALS_URL=https://your-domain.metered.live/api/v1/turn/credentials?apiKey=YOUR_KEY
#
# Option B: static long-term credentials:
# VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp,turns:global.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
#
# Optional comma-separated STUN URLs (default: stun:stun.l.google.com:19302):
# VITE_STUN_URLS=
